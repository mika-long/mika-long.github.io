/*-- scss:defaults --*/

@import url('https://fonts.googleapis.com/css2?family=Source+Sans+Pro:wght@400;600&display=swap');

// Colors
$dark-green: #858E79;
$light-green: #D1D9CE;
$cream: #FDFBF7;
$gray: #64605f;
$purple: #9158A2;
$orange: #ad7237;

// use vars in CSS rules (we'll learn more about how to write CSS soon!)
h1 {
  font-color: $darkblue;
}

.button-styling {
  background: $teal;
  color: $darkblue;
  border-color: $orange;
}

.gray-text{
  color: $orange;
}

.paper-link {
    text-decoration: none;
    display: inline-block;
    padding: 0px 5px 0px 2px;
    background-color: #00b3b3;
    border-radius: 8px;
    color: whitesmoke;
    font-weight: 600;
    position: relative;
    transition: all 0.3s ease;
}
