library(tidyverse)
library(ggplot2)
library(glue)
library(gganimate)
# custom theme
theme_custom <- function() {
theme_minimal() +
theme(
text = element_text(family = "Avenir"),
plot.title = element_text(family = "Avenir"),
axis.text = element_text(family="Avenir")
)
}
theme_set(theme_custom())
df <- read.csv(file = "US-National-Parks_Use_1979-2023_By-Month.csv") %>%
tibble(.) %>%
mutate(ParkName = str_remove(ParkName, "NP.*$")) |>
mutate(ParkName = trimws(ParkName)) %>%
mutate(Region = trimws(Region))
knitr::kable(head(df))
df
df
df %>% select(UnitCode, Year, Month, RecreationVisits)
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(Month) %>%
mutate(avg_rec_visits = mean(RecreationVisits))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(Month) %>%
summarise(avg_rec_visits = mean(RecreationVisits))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = mean(RecreationVisits))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = round(mean(RecreationVisits)))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = round(mean(RecreationVisits))) %>%
ggplot(aes(x = Month, y = avg_rec_visits)) +
geom_line() +
facet_wrap(~UnitCode) +
scale_x_continuous(breaks = 1:12, labels = 1:12)
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
mutate(avg_rec_visits = round(mean(RecreationVisits)))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = round(mean(RecreationVisits)),
pct_of_max = avg_rec_visits / max(avg_rec_visits))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = round(mean(RecreationVisits)))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = round(mean(RecreationVisits))) %>%
group_by(UnitCode) %>%
mutate(pct_of_max = avg_rec_visits / max(avg_rec_visits))
df %>% select(UnitCode, Year, Month, RecreationVisits) %>%
group_by(UnitCode, Month) %>%
summarise(avg_rec_visits = round(mean(RecreationVisits))) %>%
group_by(UnitCode) %>%
mutate(pct_of_max = avg_rec_visits / max(avg_rec_visits)) %>%
ggplot(aes(x = Month, y = pct_of_max)) +
geom_line() +
facet_wrap(~UnitCode) +
scale_x_continuous(breaks = 1:12, labels = 1:12)
#| column: page
df %>%
ggplot(aes(x = Month, y = RecreationVisits, color = Year, group = Year)) +
geom_line() +
facet_wrap(~UnitCode) +
scale_x_continuous(breaks = 1:12, labels = 1:12) +
scale_color_viridis_c()
df %>% filter(ParkName == "Acadia") %>%
ggplot(aes(x = Month, y = RecreationVisits, color = Year, group = Year)) +
geom_line() +
scale_color_viridis_c()+
scale_x_continuous(breaks = 1:12, labels = 1:12) +
scale_y_continuous(labels = function(x) paste0(x/1000, "K"))
df %>% filter(ParkName == "Acadia") %>%
ggplot(aes(x = Month, y = RecreationVisits, color = Year, group = Year)) +
geom_line(linewidth=1.5) +
scale_color_viridis_c()+
scale_x_continuous(breaks = 1:12, labels = 1:12) +
scale_y_continuous(labels = function(x) paste0(x/1000, "K")) +
labs(title = 'Year: {frame_time}') +
transition_time(Year) +
shadow_mark(past = T, future = F, alpha = 0.1)
