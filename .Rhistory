# formula
f <- bf(value ~ 1)
make_stancode(f, data = df)
# Define the data
N <- 100
my_x <- rnorm(N, 0, 1)
stan_data <- list(
N = N,
x = my_x
)
model <- cmdstan_model("ex1.stan")
fit1 <- model$sample(
data = stan_data,
chains = 4,
fixed_param = TRUE,
iter_warmup = 0,
iter_sampling = 1000,
refresh = 0
)
fit1$draws("y_sim") %>% as_draws_df(.)
fit1$draws("y_sim") %>% as_draws_df(.) %>%
select(1)
